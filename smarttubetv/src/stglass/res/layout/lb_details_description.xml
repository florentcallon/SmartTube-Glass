<!-- SmartTube Glass override of leanback-1.0.0/src/main/res/layout/lb_details_description.xml: player title
     capsule hugging the title and channel. On this view (not its container) so it hides with the description
     in compact (seek) mode. Only Glass Player themes set ?attr/glassPlayerCapsule. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/glassPlayerCapsule"
    android:paddingStart="?attr/glassPlayerCapsulePaddingH"
    android:paddingEnd="?attr/glassPlayerCapsulePaddingH"
    android:paddingTop="?attr/glassPlayerCapsulePaddingV"
    android:paddingBottom="?attr/glassPlayerCapsulePaddingV"
    >

    <!-- Top margins set programatically -->
    <androidx.leanback.widget.ResizingTextView
        android:id="@+id/lb_details_description_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/detailsDescriptionTitleStyle"
        />

    <TextView
        android:id="@+id/lb_details_description_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/detailsDescriptionSubtitleStyle"
        />

    <TextView
        android:id="@+id/lb_details_description_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/detailsDescriptionBodyStyle"
        />
</LinearLayout>
