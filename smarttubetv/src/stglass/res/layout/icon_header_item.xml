<?xml version="1.0" encoding="utf-8"?>
<!-- SmartTube Glass override of smarttubetv/src/main/res/layout/icon_header_item.xml: 44dp pill entry.
     IconHeaderItemPresenter inflates it with a null parent, so layout_* values are dropped: size comes from
     minHeight/minWidth, the 8dp inset from the grid paddingStart (24dp).
     Geometry (spec §6.1): pill from 24dp, icon at 36-60dp (centred in the 16-80dp rail), label from 80dp.
     Collapsed, the grid ends at 72dp: the pill shrinks to 24-72dp and the label gets no room. -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:minWidth="230dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/glass_header_pill"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/header_icon" />

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"

        android:singleLine="true"
        android:maxWidth="150sp"
        android:fontFamily="@font/glass_figtree"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"

        style="@style/TextAppearance.Leanback.Header"/>
</androidx.leanback.widget.NonOverlappingLinearLayout>
