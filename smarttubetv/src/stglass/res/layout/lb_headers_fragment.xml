<!-- SmartTube Glass override of leanback-1.0.0/src/main/res/layout/lb_headers_fragment.xml:
     floating glass panel behind the headers. When collapsed, BrowseSupportFragment narrows this root
     to lb_browse_headers_rail_width (88dp); its padding clips the labels, leaving the icons. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browse_headers_root"
    android:transitionGroup="true"
    android:layout_width="@dimen/lb_browse_headers_width"
    android:layout_height="match_parent"
    android:paddingEnd="@dimen/lb_browse_header_padding_end"
    android:elevation="@dimen/lb_browse_headers_z"
    android:background="@drawable/glass_headers_panel"
    >
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/browse_headers"
        android:layout_width="@dimen/lb_browse_headers_width"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        style="?attr/headersVerticalGridStyle"/>
    <!-- Kept for HeadersSupportFragment (it paints the brand colour fade on it); unused by the panel -->
    <View
        android:id="@+id/fade_out_edge"
        android:layout_alignParentEnd="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/lb_headers_right_fading" >
    </View>
</RelativeLayout>
