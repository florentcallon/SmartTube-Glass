<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Neutral values for the glass attributes, applied without force to every activity theme by
         GlassInitProvider: classic schemes get them, Glass schemes keep their own. -->
    <style name="GlassDefaults">
        <item name="glassAmbient">false</item>
        <item name="glassScrim">#B3000000</item>
        <item name="glassTint">#14FFFFFF</item>
        <item name="glassTintFocus">#29FFFFFF</item>
        <item name="glassStroke">#1FFFFFFF</item>
        <item name="glassAccent">#FF0033</item>
        <item name="glassTextSecondary">#99FFFFFF</item>
        <item name="glassPlayerTint">#8C0A0A0C</item>
        <!-- upstream card colours: card_default_text, card_selected_text_grey, card_selected_background_white -->
        <item name="glassCardText">#FFFFFF</item>
        <item name="glassCardSelectedText">#343434</item>
        <item name="glassCardSelectedBackground">#FFFFFF</item>
        <!-- no glass structure: upstream side menu (hidden when collapsed) and square, unoutlined cards -->
        <item name="glassHeadersRailWidth">0dp</item>
        <item name="glassHeadersPaddingTop">0dp</item>
        <item name="glassHeadersPanel">@null</item>
        <item name="glassHeaderPill">@null</item>
        <item name="glassCardRadius">0dp</item>
        <item name="glassBadgeRadius">0dp</item>
        <item name="glassCardFocus">@null</item>
        <item name="glassCardGlow">#00000000</item>
        <item name="glassFocusOutline">@null</item>
    </style>
</resources>
