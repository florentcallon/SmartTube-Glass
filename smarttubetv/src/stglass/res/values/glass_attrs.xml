<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SmartTube Glass theme attributes (spec §5.3). Set by App.Theme.Glass.*, defaults in GlassDefaults. -->
    <!-- true only in Glass Browse themes: enables the ambient background -->
    <attr name="glassAmbient" format="boolean" />
    <attr name="glassScrim" format="color" />
    <attr name="glassTint" format="color" />
    <attr name="glassTintFocus" format="color" />
    <attr name="glassStroke" format="color" />
    <attr name="glassAccent" format="color" />
    <attr name="glassTextSecondary" format="color" />
    <attr name="glassPlayerTint" format="color" />
    <!-- Card text and selected background, read through res/color overrides of upstream colours -->
    <attr name="glassCardText" format="color" />
    <attr name="glassCardSelectedText" format="color" />
    <attr name="glassCardSelectedBackground" format="color" />
</resources>
