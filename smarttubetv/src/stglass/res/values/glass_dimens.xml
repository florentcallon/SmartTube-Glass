<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 8dp between the 44dp pill entries (upstream: 10dp between bare rows) -->
    <dimen name="browse_headers_vertical_spacing">8dp</dimen>
    <!-- No zoom on the focused side menu entry: the pill already marks focus and must stay inside the panel -->
    <item format="float" name="lb_browse_header_select_scale" type="dimen">1.0</item>
    <!-- No elevation on focused cards: Glass cards are transparent, a shadow shows through as a dark box.
         The side menu elevation pointed at this value: keep it explicit. -->
    <dimen name="lb_material_shadow_focused_z">0dp</dimen>
    <dimen name="lb_browse_headers_z">10dp</dimen>
</resources>
