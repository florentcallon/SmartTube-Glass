             columns from the display width), the title starts after the rail. -->
        <item name="itemsVerticalGridStyle">@style/Glass.GridView</item>
        <item name="rowHorizontalGridStyle">@style/Glass.RowView</item>
        <item name="rowHeaderDockStyle">@style/Glass.RowHeaderDock</item>
        <item name="browseTitleViewStyle">@style/Glass.TitleView</item>
        <item name="imageCardViewTitleStyle">@style/Glass.CardTitle</item>
        <item name="imageCardViewContentStyle">@style/Glass.CardContent</item>
        <item name="rowHeaderStyle">@style/Glass.RowHeader</item>
        <item name="cardProgressStyle">@style/Glass.CardProgress</item>
        <item name="glassHeadersRailWidth">88dp</item>
        <item name="glassHeadersPaddingTop">88dp</item>
        <item name="glassHeadersPanel">@drawable/glass_headers_panel</item>
        <item name="glassHeaderPill">@drawable/glass_header_pill</item>
        <item name="glassCardRadius">16dp</item>
        <item name="glassBadgeRadius">6dp</item>
        <!-- focus = soft glow behind the thumbnail (GlassGlowView), no outline -->
        <item name="glassCardFocus">@null</item>
        <item name="glassCardGlow">@color/glass_rose_glow</item>
        <item name="imageCardViewStyle">@style/Glass.ImageCardView</item>
        <item name="glassFocusOutline">@drawable/glass_focus_outline</item>
        <item name="glassAmbient">true</item>
        <item name="brandAccentColor">@color/glass_rose_accent</item>
        <!-- Free-text cards: no box behind the title, even when focused -->
        <item name="cardDefaultBackground">@android:color/transparent</item>
        <item name="cardSelectedBackground">@android:color/transparent</item>
        <item name="glassCardText">#C7FFFFFF</item>
        <item name="glassCardSelectedText">#FFFFFF</item>
        <!-- Focus fill of tag chips and settings titles (opaque: translucent layers stack) -->
        <item name="glassCardSelectedBackground">@color/glass_rose_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_rose_accent</item>
        <item name="glassScrim">@color/glass_rose_scrim</item>
        <item name="glassTint">@color/glass_rose_tint</item>
        <item name="glassTintFocus">@color/glass_rose_tint_focus</item>
        <item name="glassStroke">@color/glass_rose_stroke</item>
        <item name="glassAccent">@color/glass_rose_accent</item>
        <item name="glassTextSecondary">@color/glass_rose_text_secondary</item>
        <item name="glassPlayerTint">@color/glass_rose_player_tint</item>
    </style>
    <style name="App.Theme.Glass.Rose.Player" parent="App.Theme.DarkGrey.Player">
        <item name="playbackProgressPrimaryColor">@color/glass_rose_accent</item>
        <item name="playbackControlsIconHighlightColor">@color/glass_rose_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_rose_accent</item>
        <item name="glassScrim">@color/glass_rose_scrim</item>
        <item name="glassTint">@color/glass_rose_tint</item>
        <item name="glassTintFocus">@color/glass_rose_tint_focus</item>
        <item name="glassStroke">@color/glass_rose_stroke</item>
        <item name="glassAccent">@color/glass_rose_accent</item>
        <item name="glassTextSecondary">@color/glass_rose_text_secondary</item>
        <item name="glassPlayerTint">@color/glass_rose_player_tint</item>
        <!-- Floating glass controls bar and title capsule (conservative insets: the upstream player is dense) -->
        <item name="glassPlayerBar">@drawable/glass_player_bar</item>
        <item name="glassPlayerBarInset">16dp</item>
        <item name="glassPlayerBarPadding">8dp</item>
        <item name="glassPlayerCapsule">@drawable/glass_player_capsule</item>
        <item name="glassControlsAlignStart">false</item>
        <item name="glassControlsCenter">true</item>
        <item name="playbackControlsTimeStyle">@style/Glass.PlayerTime</item>
    </style>
    <style name="App.Theme.Glass.Rose.Preferences" parent="App.Theme.DarkGrey.Preferences">
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_rose_accent</item>
    </style>
</resources>
