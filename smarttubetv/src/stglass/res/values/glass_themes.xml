<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- SmartTube Glass color schemes, registered by MainUIData.initGlassColorSchemes().
         They extend the Dark Grey schemes and only change colors.
         windowBackground stays opaque: BackgroundManager does not work with a translucent window. -->

    <!-- Paddings used with the icon rail (see App.Theme.Glass.*.Browse) -->
    <style name="Glass.GridView" parent="GridViewStyle">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Glass.RowView" parent="RowViewStyle">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Glass.RowHeaderDock" parent="Widget.Leanback.Row.HeaderDock">
        <item name="android:paddingStart">8dp</item>
    </style>
    <style name="Glass.TitleView" parent="Widget.Leanback.TitleView">
        <item name="android:paddingStart">24dp</item>
    </style>

    <!-- Figtree typography (cards, row titles) -->
    <style name="Glass.CardTitle" parent="Widget.Leanback.ImageCardView.TitleStyle">
        <item name="android:fontFamily">@font/glass_figtree</item>
    </style>
    <style name="Glass.CardContent" parent="Widget.Leanback.ImageCardView.ContentStyle">
        <item name="android:fontFamily">@font/glass_figtree</item>
    </style>
    <style name="Glass.RowHeader" parent="Widget.Leanback.Row.Header">
        <item name="android:fontFamily">@font/glass_figtree</item>
    </style>

    <!-- Glass Noir -->
    <style name="App.Theme.Glass.Noir.Browse" parent="App.Theme.DarkGrey.Browse">
        <item name="android:windowBackground">@color/glass_noir_shelf</item>
        <item name="shelfBackground">@drawable/glass_noir_shelf</item>
        <!-- The side panel is drawn by lb_headers_fragment.xml -->
        <item name="brandColor">@android:color/transparent</item>
        <!-- Room for the 88dp icon rail: grids keep upstream's usable width (GridFragmentHelper sizes
             columns from the display width). The title sits left-aligned above the side panel. -->
        <item name="itemsVerticalGridStyle">@style/Glass.GridView</item>
        <item name="rowHorizontalGridStyle">@style/Glass.RowView</item>
        <item name="rowHeaderDockStyle">@style/Glass.RowHeaderDock</item>
        <item name="browseTitleViewStyle">@style/Glass.TitleView</item>
        <item name="imageCardViewTitleStyle">@style/Glass.CardTitle</item>
        <item name="imageCardViewContentStyle">@style/Glass.CardContent</item>
        <item name="rowHeaderStyle">@style/Glass.RowHeader</item>
        <item name="glassAmbient">true</item>
        <item name="brandAccentColor">@color/glass_noir_accent</item>
        <item name="cardDefaultBackground">@color/glass_noir_card</item>
        <item name="cardSelectedBackground">@color/glass_card_selected</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_noir_accent</item>
        <item name="glassScrim">@color/glass_noir_scrim</item>
        <item name="glassTint">@color/glass_noir_tint</item>
        <item name="glassTintFocus">@color/glass_noir_tint_focus</item>
        <item name="glassStroke">@color/glass_noir_stroke</item>
        <item name="glassAccent">@color/glass_noir_accent</item>
        <item name="glassTextSecondary">@color/glass_noir_text_secondary</item>
        <item name="glassPlayerTint">@color/glass_noir_player_tint</item>
    </style>
    <style name="App.Theme.Glass.Noir.Player" parent="App.Theme.DarkGrey.Player">
        <item name="playbackProgressPrimaryColor">@color/glass_noir_accent</item>
        <item name="playbackControlsIconHighlightColor">@color/glass_noir_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_noir_accent</item>
        <item name="glassScrim">@color/glass_noir_scrim</item>
        <item name="glassTint">@color/glass_noir_tint</item>
        <item name="glassTintFocus">@color/glass_noir_tint_focus</item>
        <item name="glassStroke">@color/glass_noir_stroke</item>
        <item name="glassAccent">@color/glass_noir_accent</item>
        <item name="glassTextSecondary">@color/glass_noir_text_secondary</item>
        <item name="glassPlayerTint">@color/glass_noir_player_tint</item>
    </style>
    <style name="App.Theme.Glass.Noir.Preferences" parent="App.Theme.DarkGrey.Preferences">
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_noir_accent</item>
    </style>

    <!-- Glass Rose -->
    <style name="App.Theme.Glass.Rose.Browse" parent="App.Theme.DarkGrey.Browse">
        <item name="android:windowBackground">@color/glass_rose_shelf</item>
        <item name="shelfBackground">@drawable/glass_rose_shelf</item>
        <!-- The side panel is drawn by lb_headers_fragment.xml -->
        <item name="brandColor">@android:color/transparent</item>
        <!-- Room for the 88dp icon rail: grids keep upstream's usable width (GridFragmentHelper sizes
             columns from the display width), the title starts after the rail. -->
        <item name="itemsVerticalGridStyle">@style/Glass.GridView</item>
        <item name="rowHorizontalGridStyle">@style/Glass.RowView</item>
        <item name="rowHeaderDockStyle">@style/Glass.RowHeaderDock</item>
        <item name="browseTitleViewStyle">@style/Glass.TitleView</item>
        <item name="imageCardViewTitleStyle">@style/Glass.CardTitle</item>
        <item name="imageCardViewContentStyle">@style/Glass.CardContent</item>
        <item name="rowHeaderStyle">@style/Glass.RowHeader</item>
        <item name="glassAmbient">true</item>
        <item name="brandAccentColor">@color/glass_rose_accent</item>
        <item name="cardDefaultBackground">@color/glass_rose_card</item>
        <item name="cardSelectedBackground">@color/glass_card_selected</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_rose_accent</item>
        <item name="glassScrim">@color/glass_rose_scrim</item>
        <item name="glassTint">@color/glass_rose_tint</item>
        <item name="glassTintFocus">@color/glass_rose_tint_focus</item>
        <item name="glassStroke">@color/glass_rose_stroke</item>
        <item name="glassAccent">@color/glass_rose_accent</item>
        <item name="glassTextSecondary">@color/glass_rose_text_secondary</item>
        <item name="glassPlayerTint">@color/glass_rose_player_tint</item>
    </style>
    <style name="App.Theme.Glass.Rose.Player" parent="App.Theme.DarkGrey.Player">
        <item name="playbackProgressPrimaryColor">@color/glass_rose_accent</item>
        <item name="playbackControlsIconHighlightColor">@color/glass_rose_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_rose_accent</item>
        <item name="glassScrim">@color/glass_rose_scrim</item>
        <item name="glassTint">@color/glass_rose_tint</item>
        <item name="glassTintFocus">@color/glass_rose_tint_focus</item>
        <item name="glassStroke">@color/glass_rose_stroke</item>
        <item name="glassAccent">@color/glass_rose_accent</item>
        <item name="glassTextSecondary">@color/glass_rose_text_secondary</item>
        <item name="glassPlayerTint">@color/glass_rose_player_tint</item>
    </style>
    <style name="App.Theme.Glass.Rose.Preferences" parent="App.Theme.DarkGrey.Preferences">
        <item name="android:colorAccent" tools:targetApi="21">@color/glass_rose_accent</item>
    </style>
</resources>
