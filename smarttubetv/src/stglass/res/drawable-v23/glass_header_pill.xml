<?xml version="1.0" encoding="utf-8"?>
<!-- Side menu entry (spec §6.1). Focused = lighter glass with a border + accent bar; activated = current
     section (set by GlassHeaders), lighter glass + accent bar, stays visible in the icon rail. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="?attr/glassTintFocus" />
                    <stroke android:width="1dp" android:color="?attr/glassStroke" />
                </shape>
            </item>
            <item android:gravity="start|center_vertical" android:width="3dp" android:height="20dp" android:left="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="?attr/glassAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="?attr/glassTintFocus" />
                </shape>
            </item>
            <item android:gravity="start|center_vertical" android:width="3dp" android:height="20dp" android:left="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="?attr/glassAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
