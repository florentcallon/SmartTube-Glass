<?xml version="1.0" encoding="utf-8"?>
<!-- Side menu entry (spec §6.1). Focused = lighter glass with a border; activated = current section
     (set by GlassHeaders, which also turns its icon to the accent colour), stays visible in the icon rail. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/glassTintFocus" />
            <stroke android:width="1dp" android:color="?attr/glassStroke" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/glassTintFocus" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
