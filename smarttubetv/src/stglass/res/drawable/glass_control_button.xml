<?xml version="1.0" encoding="utf-8"?>
<!-- Player control button (spec §6.3): when focused, a bright glass disc with an accent ring (upstream's focus
     ripple is 40% white; the disc is the only focus cue). Pressed is brighter. Not accent-filled: active icons
     use the accent colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
            <stroke android:width="2dp" android:color="?attr/glassAccent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#59FFFFFF" />
            <stroke android:width="2dp" android:color="?attr/glassAccent" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
