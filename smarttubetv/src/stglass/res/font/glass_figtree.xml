<?xml version="1.0" encoding="utf-8"?>
<!-- Figtree (SIL OFL 1.1, glass/fonts/OFL.txt). One variable font file; weights picked through
     fontVariationSettings (API 26+, older devices use the file's default instance). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/figtree_variable"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/figtree_variable"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
</font-family>
